        name="external_storage"
        path="." />

    <!-- 下载目录 -->
    <external-path
        name="downloads"
        path="Download/" />

    <!-- 图片目录 -->
    <external-path
        name="pictures"
        path="Pictures/" />

    <!-- DCIM目录（相机照片） -->
    <external-path
        name="dcim"
        path="DCIM/" />
