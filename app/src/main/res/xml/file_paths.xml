        name="internal_files"
        path="." />

    <!-- 应用缓存目录 -->
    <cache-path
        name="internal_cache"
        path="." />

    <!-- 应用外部私有存储 -->
    <external-files-path
        name="external_files"
        path="." />

    <!-- 外部缓存目录 -->
