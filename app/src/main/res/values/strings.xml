    <string name="task">Scheduled Tasks</string>
    <string name="task_tips">When enabled, tasks fire on their cron schedule: each firing is wrapped into a message and handed to plugins. If the type is still task after plugin processing, the message is dropped. Task messages go through the same pipeline as MQTT, API and notification listening, so notification, repost and storage all apply. Alarms are rescheduled after a reboot or an app update. Under Doze an alarm may be delayed by a few minutes but is never dropped; trigger points missed while the device is powered off are not replayed.</string>
    <string name="task_group">Scheduled</string>
    <string name="task_add">New Task</string>
    <string name="task_edit">Edit Task</string>
    <string name="task_name">Task Name</string>
    <string name="task_name_placeholder">For example: daily check-in</string>
    <string name="task_cron">Cron Expression</string>
    <string name="task_cron_placeholder">*/30 * * * *</string>
    <string name="task_cron_invalid">Invalid expression format</string>
    <string name="task_cron_never">This expression never fires</string>
    <string name="task_cron_tips">5 fields, same as Linux crontab: minute hour day month weekday.\nSupports * for any, 5 for a single value, 1-10 for a range, */5 for a step, 1,3,5 for a list, JAN~DEC for months and SUN~SAT for weekdays.\nExamples: */30 * * * * every 30 minutes; 0 9 * * 1-5 weekdays at 9; 0 0 1 * * the 1st day of each month at midnight.</string>
    <string name="task_content">Task Content</string>
    <string name="task_content_placeholder">Content handed to plugins, read it as content</string>
    <string name="task_enabled">Enable Task</string>
    <string name="task_test">Send Test Message</string>
    <string name="task_test_name">Test Task</string>
    <string name="task_test_tips">Sends the name and content above right now as one trigger, no need to wait for the schedule or save first. It goes through the full plugin pipeline: a message no plugin takes over (type is still task) is discarded.</string>
